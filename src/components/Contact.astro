<section class="ct" id="contact">
  <div class="shell ct-g">
    <div>
      <span class="tag">Contact</span>
      <h2>Travaillons<br><em>ensemble</em></h2>
      <dl>
        <dt>Email</dt><dd><a href="mailto:edouard.rchd@gmail.com">edouard.rchd@gmail.com</a></dd>
        <dt>Téléphone</dt><dd><a href="tel:+33768224657">07 68 22 46 57</a></dd>
        <dt>Basé à</dt><dd>Rouen, Normandie — déplacements France entière</dd>
        <dt>Disponibilité</dt><dd>Week-ends et soirées de match, toute la saison</dd>
      </dl>
    </div>
    <div>
      <form id="fm" novalidate>
        <div class="f2">
          <div class="fr"><label for="q1">Nom</label><input id="q1" name="nom" type="text" autocomplete="name" required></div>
          <div class="fr"><label for="q2">Email</label><input id="q2" name="email" type="email" autocomplete="email" required></div>
        </div>
        <div class="f2">
          <div class="fr"><label for="q3">Club / structure</label><input id="q3" name="structure" type="text"></div>
          <div class="fr"><label for="q4">Discipline</label>
            <select id="q4" name="discipline">
              <option>Hockey sur glace</option><option>Basketball</option><option>Football</option>
              <option>Boxe</option><option>Autre</option>
            </select>
          </div>
        </div>
        <div class="fr"><label for="q5">Date de la rencontre</label><input id="q5" name="date" type="text" placeholder="Ex. samedi 14 mars, 20 h"></div>
        <div class="fr"><label for="q6">Message</label><textarea id="q6" name="message" required></textarea></div>
        <button type="submit" class="send">Envoyer la demande</button>
        <p class="note">Le formulaire ouvre votre messagerie avec la demande pré-remplie.
          Pour un envoi direct, renseignez l'adresse Formspree dans la variable ENDPOINT du script.</p>
        <div class="okmsg" id="ok"></div>
      </form>
    </div>
  </div>
</section>

