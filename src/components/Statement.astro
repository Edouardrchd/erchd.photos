---
import { SERIES, TOTAL } from '../data/series';

const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="state">
  <div class="shell state-g">
    <div>
      <span class="tag">Le travail</span>
      <p class="lead">Je photographie depuis le <em>bord du terrain</em> : la lumière crue des salles,
        l'attente avant l'entrée, la <b>seconde où tout bascule</b>.</p>
      <p class="sub">Hockey, basket, football et boxe, en Normandie et dans le Grand Ouest.
        Chaque rencontre repart avec une sélection triée et retouchée, prête pour la presse,
        les réseaux du club ou l'affichage.</p>
    </div>
    <div>
      <div class="facts">
        <div class="fact"><b class="num">{TOTAL}</b><span>Vues publiées</span></div>
        <div class="fact"><b class="num">{pad(SERIES.length)}</b><span>Disciplines</span></div>
        <div class="fact"><b class="num">48</b><span>Heures de livraison</span></div>
        <div class="fact"><b class="num">06</b><span>Clubs couverts</span></div>
      </div>
      <div class="gearl">
        <div><span>Canon EOS M50 Mark II</span><span>Boîtier</span></div>
        <div><span>EF-M 15-45 mm</span><span>Grand angle</span></div>
        <div><span>EF-M 55-200 mm</span><span>Téléobjectif</span></div>
        <div><span>Rouen — France entière</span><span>Déplacements</span></div>
      </div>
    </div>
  </div>
</section>
