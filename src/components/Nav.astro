---
import { SERIES } from '../data/series';
---

<header class="nav" id="nav">
  <a href="#haut" class="mk" aria-label="Edouard Richard, retour en haut">
    <b>ER</b><span>Edouard <i>Richard</i></span>
  </a>
  <nav class="nl" aria-label="Séries">
    {SERIES.map((s) => <a href={`#${s.id}`} data-s={s.id}>{s.short}</a>)}
    <span class="sep" aria-hidden="true"></span>
    <a href="#atelier" data-s="atelier">Atelier</a>
    <a href="#contact" data-s="contact">Contact</a>
  </nav>
  <div class="tools">
    <button class="ghost iconbtn" id="modebtn" title="Passer en clair / sombre" aria-label="Passer en affichage clair ou sombre">
      <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.6M12 19.4V22M2 12h2.6M19.4 12H22M4.9 4.9l1.9 1.9M17.2 17.2l1.9 1.9M19.1 4.9l-1.9 1.9M6.8 17.2l-1.9 1.9"/>
      </svg>
      <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1Z"/>
      </svg>
    </button>
    <button class="ghost" id="twbtn" aria-controls="tw" aria-expanded="false" title="Réglages d'affichage (R)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M3 7h11M18 7h3M3 17h4M11 17h10"/><circle cx="16" cy="7" r="2.4"/><circle cx="9" cy="17" r="2.4"/>
      </svg><span>Réglages</span>
    </button>
    <button class="burger" id="bg" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="sheet">
      <span></span><span></span>
    </button>
  </div>
</header>

<div class="sheet" id="sheet">
  <nav aria-label="Menu principal">
    {SERIES.map((s) => (
      <a href={`#${s.id}`} data-s={s.id}>
        <span class="mi-n">{s.numeral}</span><span class="mi-t">{s.title}</span><span class="mi-c">{s.count}</span>
      </a>
    ))}
    <a href="#atelier" data-s="atelier">
      <span class="mi-n">V</span><span class="mi-t">Atelier</span><span class="mi-c">—</span>
    </a>
  </nav>
  <div class="sheet-f">
    <span class="tag d">Contact</span>
    <a href="mailto:edouard.rchd@gmail.com" class="big">edouard.rchd@gmail.com</a>
    <a href="tel:+33768224657" class="big">07 68 22 46 57</a>
  </div>
</div>
