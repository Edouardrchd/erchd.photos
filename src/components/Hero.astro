---
import { TOTAL } from '../data/series';
---

<section class="hero" id="haut">
  <div class="hero-m" id="hm">
    <picture>
      <source media="(min-width:900px)" srcset="/images/accueil-large.jpg">
      <img src="/images/accueil-mobile.jpg" alt="Joueur de hockey sur glace saisi depuis le bord de la patinoire" fetchpriority="high">
    </picture>
  </div>
  <div class="hero-v"></div>
  <span class="rail">Planche 01 — sélection 2024–2026</span>
  <div class="hero-i">
    <span class="tag">Photographe sportif — Rouen, Normandie</span>
    <h1><span class="ln a"><i>Edouard</i></span><span class="ln b"><i>Richard</i></span></h1>
    <div class="hero-f">
      <dl>
        <div><dt>Disciplines</dt><dd>Hockey, basket, football, boxe</dd></div>
        <div><dt>Sélection</dt><dd class="num">{TOTAL} vues — 2024/2026</dd></div>
        <div><dt>Livraison</dt><dd>Sous 48 heures</dd></div>
      </dl>
      <span class="cue">Défiler</span>
    </div>
  </div>
</section>

<div class="ticker" aria-hidden="true">
  <div class="tick-t">
    <span>Hockey sur glace</span><span><em>Basketball</em></span><span>Football</span><span><em>Boxe</em></span>
    <span>Bord de terrain</span><span><em>Lumière de salle</em></span>
    <span>Hockey sur glace</span><span><em>Basketball</em></span><span>Football</span><span><em>Boxe</em></span>
    <span>Bord de terrain</span><span><em>Lumière de salle</em></span>
  </div>
</div>
