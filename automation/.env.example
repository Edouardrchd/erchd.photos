# =========================================================================
#  Secrets de la chaine d'automatisation
#  Copier en `.env` et remplir. NE JAMAIS COMMITER le fichier `.env`.
#  En production : utiliser GitHub Secrets, Doppler, 1Password ou AWS
#  Secrets Manager plutot qu'un fichier sur disque.
# =========================================================================

# --- Anthropic (redaction : selection des coupes, titres, descriptions) ---
# Console : https://console.anthropic.com  -> Settings -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Transcription (uniquement si provider = assemblyai) -----------------
# https://www.assemblyai.com/app/account
ASSEMBLYAI_API_KEY=

# --- Stockage objet : indispensable, Instagram telecharge la video par URL -
# Cloudflare R2 (recommande : egress gratuit) ou AWS S3.
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=erchd-shorts
# Domaine public servant le bucket (r2.dev ou domaine perso branche sur R2)
S3_PUBLIC_BASE_URL=https://media.erchd.photos

# --- Meta / Instagram ----------------------------------------------------
# App Meta -> Instagram -> API setup with Instagram login
# Token longue duree (60 jours) a rafraichir : voir docs/01-connexions.md
IG_USER_ID=
IG_ACCESS_TOKEN=
# Version de l'API Graph epinglee (evite les ruptures silencieuses)
IG_GRAPH_VERSION=v21.0

# --- TikTok --------------------------------------------------------------
# https://developers.tiktok.com -> Manage apps -> Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# --- YouTube (Google Cloud) ---------------------------------------------
# Console Google Cloud -> API & Services -> Credentials -> OAuth client ID
# (type "Desktop app"). Le refresh token est genere par `python -m src.cli auth-youtube`
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Notifications (optionnel) ------------------------------------------
# Webhook Slack ou Discord pour la validation humaine
REVIEW_WEBHOOK_URL=
